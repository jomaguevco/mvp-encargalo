# Copia este archivo como .env y completa con los datos de tu proyecto Supabase.
# Supabase -> Project Settings -> Data API / API Keys
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANONIMA

# Cuenta a la que los clientes yapean durante el piloto (escrow operado a mano)
EXPO_PUBLIC_YAPE_NUMERO=999 999 999
EXPO_PUBLIC_YAPE_TITULAR=Encargalo SAC
